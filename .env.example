# ─────────────────────────────────────────────────────────────
# VGP Universe — Environment Variables
# Copy to .env.local for local dev, and set the SAME keys in
# Vercel → Project → Settings → Environment Variables for production.
# Missing keys cause runtime crashes (auth, DB, crons), not build errors,
# so they are easy to miss. Keep this list complete.
# ─────────────────────────────────────────────────────────────

# Database — Supabase Postgres. Use the Supavisor pooler connection string
# (host ends with .pooler.supabase.com) so serverless connection limits hold.
DATABASE_URL=postgres://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Token signing (unsubscribe links + founder session cookie).
# Generate once with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Founder dashboard login passcode.
FOUNDER_PASSCODE=CHANGE_ME_FOUNDER_PASSCODE

# Keep false until the founder_internal migration has been applied and checked.
# When true, /founder/os loads its private DB snapshot and persists settings.
FOUNDER_OS_ENABLE_DATABASE=false

# Private Custom GPT Action authentication. This is separate from ChatGPT Plus
# and must be entered as the Action's Bearer API key in the GPT Builder.
# Generate once with: openssl rand -hex 32
FOUNDER_OS_GPT_ACTION_SECRET=CHANGE_ME_LONG_RANDOM_STRING
# Separate server-only bearer for the installable Codex plugin bridge.
FOUNDER_OS_BRIDGE_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM_STRING

# Canonical public origin. OAuth redirects must use this exact HTTPS origin.
APP_URL=https://www.virzyguns.com

# AES-256-GCM key used only to encrypt Meta/TikTok access + refresh tokens at
# rest. Generate once, keep version 1 until a deliberate key-rotation session:
# node -e "console.log('hex:'+require('node:crypto').randomBytes(32).toString('hex'))"
FOUNDER_OS_TOKEN_ENCRYPTION_KEY=hex:CHANGE_ME_64_HEX_CHARACTERS
FOUNDER_OS_TOKEN_ENCRYPTION_KEY_VERSION=1

# Mark a stuck provider execution UNKNOWN after this many seconds. UNKNOWN is a
# manual reconciliation state and is never auto-retried.
FOUNDER_OS_PROVIDER_STALE_EXECUTION_SECONDS=900

# Quarantine an interrupted Founder OS SMTP execution as UNKNOWN after this
# many seconds. UNKNOWN is never resent automatically.
FOUNDER_OS_EMAIL_STALE_EXECUTION_SECONDS=900

# Meta / Instagram professional-account OAuth + webhooks.
# Redirect URI:
# https://www.virzyguns.com/api/founder/os/providers/meta/oauth/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://www.virzyguns.com/api/founder/os/providers/meta/oauth/callback
META_GRAPH_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=

# TikTok Login Kit + Content Posting API.
# Redirect URI:
# https://www.virzyguns.com/api/founder/os/providers/tiktok/oauth/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://www.virzyguns.com/api/founder/os/providers/tiktok/oauth/callback

# Only HTTPS hosts controlled by VGP that Meta/TikTok may pull media from.
PROVIDER_ALLOWED_MEDIA_HOSTS=www.virzyguns.com,virzyguns.com

# Keep false until TikTok has approved/audited public Direct Post. Draft upload
# remains the intended first release path.
TIKTOK_DIRECT_POST_ENABLED=false

# Cron authorization — shared secret. The SAME value must be set on the
# Cloudflare Worker that triggers /api/cron/process-campaigns every 10 min.
# Generate once with: openssl rand -hex 32
CRON_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Hostinger SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=founder@virzyguns.com
SMTP_PASS=YOUR_PASSWORD_HERE

# Google PageSpeed Insights (optional — without a key the public API is
# heavily rate-limited and the dashboard falls back to cached metrics).
PAGESPEED_API_KEY=

# Flowstate product database (optional) — Supabase Postgres holding the
# flowstate_* tables. Powers the founder dashboard's Flowstate tab.
# Without it the tab shows an honest "not connected" state (no fake numbers).
# Use the Supavisor pooler connection string, same as DATABASE_URL.
FLOWSTATE_DATABASE_URL=

# Sentry (optional) — error counts on the founder dashboard's Flowstate tab.
# Create an auth token with scopes: event:read project:read.
# Without it the Errors panel shows an honest "not connected" state.
SENTRY_AUTH_TOKEN=
# Defaults: org virzy-guns-production, project flowstate. Override if needed.
# SENTRY_ORG=
# SENTRY_PROJECT_SLUG=

# PostHog (optional) — anonymous visitor counts on the Flowstate tab.
# Create a Personal API key with scope: query:read.
# Without it the Visitors panel shows an honest "not connected" state.
POSTHOG_PERSONAL_API_KEY=
# Defaults: project id 511095, host https://us.posthog.com. Override if needed.
# POSTHOG_PROJECT_ID=
# POSTHOG_QUERY_HOST=

# Google Search Console (server-only) â€” a single valid raw JSON object from a
# read-only service account. Do not paste an escaped JSON string; malformed
# escapes (for example \s) are rejected and surfaced as a connector error.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional domain property override. Defaults to sc-domain:virzyguns.com.
# GSC_SITE_URL=
