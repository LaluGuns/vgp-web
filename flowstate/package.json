{
  "name": "flowstate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --no-cache",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test \"scripts/release/*.test.mjs\" && node scripts/i18n/check-parity.cjs",
    "seo:crawl": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/release/runtime-seo-crawl.mjs",
    "predeploy": "npm run typecheck && npm run lint && npm test && npm run build",
    "mobile:dev": "vite --config mobile/vite.config.ts",
    "mobile:typecheck": "tsc -p mobile/tsconfig.json --noEmit",
    "mobile:build": "vite build --config mobile/vite.config.ts",
    "mobile:verify": "node mobile/scripts/verify-mobile-source.mjs",
    "mobile:add:android": "cd mobile && npx cap add android",
    "mobile:apply:android": "node mobile/scripts/apply-android-native.mjs",
    "mobile:sync:android": "npm run mobile:build && cd mobile && npx cap sync android",
    "mobile:prepare:android": "npm run mobile:build && npm run mobile:apply:android && cd mobile && npx cap sync android",
    "worker:sync-catalog": "npx wrangler r2 object put flowstate-audio/tracks/catalog.json --file public/tracks/catalog.json --content-type application/json --remote --force --config worker/wrangler.toml",
    "worker:deploy": "npx wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/nextjs": "^10.64.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.5",
    "lucide-react": "^0.575.0",
    "next": "15.5.21",
    "posthog-js": "^1.398.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.0",
    "three": "^0.185.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@capacitor/android": "8.5.1",
    "@capacitor/cli": "8.5.1",
    "@emnapi/core": "^1.7.1",
    "@emnapi/runtime": "^1.7.1",
    "@eslint/eslintrc": "^3.3.6",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.21",
    "ffmpeg-static": "^5.3.0",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "8.2.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.8",
    "dompurify": "3.4.13",
    "fast-uri": "3.1.6",
    "nanoid": "3.3.18",
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.0"
    }
  }
}
