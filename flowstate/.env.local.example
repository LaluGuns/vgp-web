# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Lemon Squeezy (web merchant of record)
LEMONSQUEEZY_API_KEY=your-api-key
LEMONSQUEEZY_STORE_ID=your-store-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_YEARLY=
LEMONSQUEEZY_VARIANT_LIFETIME=

# Google Play Billing (Android)
# Store the complete service-account JSON as one environment variable. Never expose it with NEXT_PUBLIC_.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_MONTHLY_PRODUCT_ID=
GOOGLE_PLAY_MONTHLY_BASE_PLAN_ID=
GOOGLE_PLAY_YEARLY_PRODUCT_ID=
GOOGLE_PLAY_YEARLY_BASE_PLAN_ID=
# Exact audience configured on the authenticated Pub/Sub push subscription.
GOOGLE_PLAY_PUBSUB_AUDIENCE=https://flow.virzyguns.com/api/webhooks/google-play
# Service-account email used by Pub/Sub to mint the push OIDC token.
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Server-only admin bearer secret for the chargeback/refund review queue.
GOOGLE_PLAY_REFUND_REVIEW_SECRET=
# Optional dedicated reconcile secret. Vercel Cron may use CRON_SECRET instead.
GOOGLE_PLAY_RECONCILE_SECRET=
CRON_SECRET=

# Signed audio delivery (Cloudflare Worker `flowstate-audio-delivery`, see worker/)
# Leave empty in dev to play from local /public files.
NEXT_PUBLIC_AUDIO_WORKER_URL=https://flowstate-audio-delivery.<account>.workers.dev

# Legacy direct-CDN base (only used when the worker URL is empty)
NEXT_PUBLIC_AUDIO_CDN_BASE_URL=

# App
NEXT_PUBLIC_APP_URL=https://flow.virzyguns.com

# Observability (empty = disabled)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN= (source-map upload, optional)
