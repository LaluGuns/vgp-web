{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.virzyguns.com/schemas/founder-os/prospect-candidate.schema.json",
  "title": "Evidence-backed Founder OS prospect candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestKey",
    "displayName",
    "segment",
    "market",
    "platform",
    "profileUrl",
    "contact",
    "evidence",
    "qualificationSignals",
    "beatMatches"
  ],
  "properties": {
    "requestKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,119}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "handle": {
      "type": ["string", "null"],
      "maxLength": 255
    },
    "segment": {
      "enum": ["rapper", "game-developer", "content-creator"]
    },
    "market": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "platform": {
      "enum": ["instagram", "tiktok", "youtube", "website", "other"]
    },
    "profileUrl": {
      "type": ["string", "null"],
      "format": "uri",
      "maxLength": 2048
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["businessEmail", "permission", "sourceEvidenceKey", "origin"],
      "properties": {
        "businessEmail": { "type": ["string", "null"], "format": "email", "maxLength": 320 },
        "permission": { "enum": ["public-business-email", "manual-only", "blocked"] },
        "sourceEvidenceKey": { "type": ["string", "null"], "maxLength": 80 },
        "origin": { "const": "source-provided" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "url", "observedAt"],
        "properties": {
          "key": { "type": "string", "maxLength": 80 },
          "label": { "type": "string", "maxLength": 500 },
          "url": { "type": "string", "format": "uri", "maxLength": 2048 },
          "observedAt": { "type": "string", "format": "date-time" },
          "note": { "type": "string", "maxLength": 10000 }
        }
      }
    },
    "qualificationSignals": { "type": "object" },
    "beatMatches": { "type": "array", "maxItems": 10, "items": { "type": "object" } }
  }
}
